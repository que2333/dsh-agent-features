{
  "name": "@que2333/dsh-edit-message",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Edits any user turn in place by rewinding the same Session log and resending with original attachments.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/que2333/dsh-agent-features.git",
    "directory": "edit-message"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
