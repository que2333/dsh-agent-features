{
  "name": "@que2333/dsh-agent-features",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Bundle for three independently toggleable Agent features: Responses summary/verbosity, archived-session management, and message editing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/que2333/dsh-agent-features.git",
    "directory": "agent-features-config"
  },
  "main": "index.js",
  "scripts": {
    "test": "node --test test/bundle.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@que2333/dsh-agent-config": "https://github.com/que2333/dsh-agent-features/releases/download/v1.1.0/que2333-dsh-agent-config-2.2.1.tgz",
    "@que2333/dsh-session-delete": "https://github.com/que2333/dsh-agent-features/releases/download/v1.1.0/que2333-dsh-session-delete-1.1.0.tgz",
    "@que2333/dsh-edit-message": "https://github.com/que2333/dsh-agent-features/releases/download/v1.1.0/que2333-dsh-edit-message-1.2.1.tgz"
  }
}
