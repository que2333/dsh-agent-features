{
  "name": "@que2333/dsh-agent-features",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "Archived chat management and in-place user message editing for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/que2333/dsh-agent-features.git"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./session-delete": "./session-delete/index.js",
    "./edit-message": "./edit-message/index.js",
    "./session-delete/locale/*.json": "./session-delete/locale/*.json",
    "./edit-message/locale/*.json": "./edit-message/locale/*.json",
    "./session-delete/icon": "./session-delete/icon.svg",
    "./edit-message/icon": "./edit-message/icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "session-delete/index.js",
    "session-delete/client.js",
    "session-delete/cordis.patch.yml",
    "session-delete/locale/*.json",
    "session-delete/icon.svg",
    "session-delete/package.json",
    "session-delete/README.md",
    "edit-message/index.js",
    "edit-message/client.js",
    "edit-message/cordis.patch.yml",
    "edit-message/locale/*.json",
    "edit-message/icon.svg",
    "edit-message/package.json",
    "edit-message/README.md",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@que2333/dsh-edit-message": "1.2.1",
    "@que2333/dsh-session-delete": "1.1.0"
  },
  "bundleDependencies": [
    "@que2333/dsh-edit-message",
    "@que2333/dsh-session-delete"
  ],
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "sync-bundle": "node scripts/sync-bundled-packages.mjs",
    "test": "node --test test/*.test.js edit-message/test/*.test.js && pnpm -r --if-present test"
  }
}
