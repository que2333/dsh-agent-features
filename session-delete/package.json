{
  "name": "@que2333/dsh-session-delete",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Manage archived chats in Settings, including permanent deletion of their session logs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/que2333/dsh-agent-features.git",
    "directory": "session-delete"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
